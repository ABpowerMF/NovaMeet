{
  "name": "novameet",
  "productName": "NovaMeet",
  "version": "1.0.0",
  "description": "Listen. Understand. Organize. — a private meeting assistant that runs on your computer.",
  "main": "out/main/index.js",
  "author": "Andre",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "docx": "^9.15.3",
    "node-llama-cpp": "^3.22.3",
    "sherpa-onnx-node": "^2.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@fontsource/inter": "^5.3.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.novameet.app",
    "productName": "NovaMeet",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**",
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "NovaMeet records your microphone during meetings you choose to record.",
        "NSScreenCaptureUsageDescription": "NovaMeet captures the meeting audio from your computer during meetings you choose to record.",
        "NSAudioCaptureUsageDescription": "NovaMeet captures the meeting audio from your computer during meetings you choose to record."
      }
    }
  }
}
